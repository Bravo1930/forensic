OAUTH_SERVER_URL=https://your-oauth-server.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-server.com
VITE_APP_ID=your-app-id

DATABASE_URL="file:./forensic_legal.db"

# Comma-separated list of allowed origins (no wildcards allowed)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-api-domain.com

JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Redis for background job queue (optional — fallback to inline processing if unset)
REDIS_URL=redis://localhost:6379

# LLM analysis cache TTL in minutes (default: 60). Set to 0 to disable caching.
ANALYSIS_CACHE_TTL_MINUTES=60

BUILT_IN_FORGE_API_URL=https://your-forge-api.com/v1/chat/completions
BUILT_IN_FORGE_API_KEY=your-forge-api-key

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LOCAL_UPLOAD_DIR=./uploads
LOCAL_BASE_URL=http://localhost:3000

OWNER_OPEN_ID=your-admin-open-id
